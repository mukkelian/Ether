# Makefile for Ether

# Avoid making changes below this line
include ../make.sys

SRCDIR := ../src
MAIN   := ether.f90
EXE    := ../ether

# All Fortran sources except the main program
SRCS := $(filter-out $(SRCDIR)/$(MAIN), $(wildcard $(SRCDIR)/*.f90))
OBJS := $(notdir $(SRCS:.f90=.o))

vpath %.f90 $(SRCDIR)

ether: $(EXE)

# $(SRCDIR) as a prerequisite: relink when a file is added or removed in src/
$(EXE): $(OBJS) $(SRCDIR)/$(MAIN) $(SRCDIR)
	$(f90comp) $(switch) $(OBJS) $(SRCDIR)/$(MAIN) -o $@

%.o: %.f90
	$(f90comp) -c $(switch) $<

# ---- automatic module dependencies -----------------------------------
# Scans the sources for "module X" and "use X" and writes rules like
#   Metropolis.o: my_module.o
# Regenerated whenever a source changes or a file is added/removed in src/.
deps.mk: $(SRCS) $(SRCDIR)
	@echo "Updating module dependencies"
	@awk ' \
	FNR==1 { obj=FILENAME; sub(/.*\//,"",obj); sub(/\.f90$$/,".o",obj) } \
	{ line=tolower($$0); sub(/!.*/,"",line); n=split(line,w,/[ \t,]+/); \
	  i=1; if (w[1]=="") i=2; \
	  if (w[i]=="module" && w[i+1]!="" && w[i+1]!~/^(procedure|function|subroutine)$$/) def[w[i+1]]=obj; \
	  if (w[i]=="use") { m=w[i+1]; if (m=="::") m=w[i+2]; if (m!="") use[obj SUBSEP m]=1 } } \
	END { for (k in use) { split(k,p,SUBSEP); \
	        if ((p[2] in def) && def[p[2]]!=p[1]) print p[1] ": " def[p[2]] } }' \
	$(SRCS) /dev/null > $@

ifneq ($(MAKECMDGOALS),clean)
-include deps.mk
endif

clean:
	rm -f *.o *.mod *.MOD *.obj deps.mk

.PHONY: ether clean
